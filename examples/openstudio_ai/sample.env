CHATBOT_SERVER_URL=http://localhost:9999

# Model settings — read directly by the YAML agent spec via ${...} interpolation.
# Set LLM_MODEL_URL to your provider's base URL (e.g. https://api.anthropic.com or a local proxy).
# Set OSSTD_LLM_API to your API key for that provider.
LLM_MODEL_NAME=claude-opus-4-7-project
LLM_MODEL_URL=https://your-llm-provider-base-url
OSSTD_LLM_API=your-api-key-here

# Kept for backwards compatibility with agent.py fallback logic.
CHAT_BOT_MODEL_NAME=llama3.1:8b
CHAT_BOT_MODEL_BASE_URL=http://localhost:11434

OPENSTUDIO_MCP_HOST=localhost
OPENSTUDIO_MCP_PORT=10210
OPENSTUDIO_PATH=/Applications/OpenStudio-3.10.0/bin/openstudio
OPENSTUDIO_SDK_DOCS_DIR=/path/to/openstudio-sdk-html
