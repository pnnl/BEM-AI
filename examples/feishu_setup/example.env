# Feishu / Lark app credentials (required)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# URL of the A2A entry agent this gateway forwards messages to
FEISHU_ENTRY_AGENT_URL=http://localhost:10001

# Path for persisting chat→contextId session mapping (optional, defaults to feishu_sessions.json)
FEISHU_SESSION_STORE_PATH=

# Outbound webhook notifications (optional)
# Set FEISHU_ENABLED=true and provide at least one webhook URL to enable push cards.
FEISHU_ENABLED=false
FEISHU_TIMEZONE=Asia/Shanghai
FEISHU_WEBHOOK_DEFAULT=
FEISHU_WEBHOOK_ORCHESTRATOR=
FEISHU_WEBHOOK_PLANNER=
FEISHU_WEBHOOK_SIMULATION=
FEISHU_WEBHOOK_OUTPUT=
FEISHU_WEBHOOK_SECRET=
