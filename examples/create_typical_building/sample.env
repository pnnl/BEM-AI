# A2A Agent Server Configuration
CHATBOT_SERVER_URL=http://localhost:8081

# LLM Model Configuration

# === OPTION 1: PNNL BIRTHRIGHT API (OpenAI-compatible) ===
# Available models:
#   - GROK: grok-4-birthright, grok-4-fast-reasoning-birthright, grok-4-fast-non-reasoning-birthright
#   - OpenAI: o4-mini-birthright, o3-birthright, gpt-5-birthright, gpt-5.1-birthright, gpt-5.2-birthright, gpt-4.1-birthright
#   - Claude: claude-sonnet-4-20250514-v1-birthright, claude-haiku-4-5-20251001-v1-birthright
# Chat model will be auto-detected based on model name
BIRTHRIGHT_API=your-birthright-api-key-here
CHAT_BOT_MODEL_NAME=claude-haiku-4-5-20251001-v1-birthright
CHAT_BOT_MODEL_BASE_URL=https://ai-incubator-api.pnnl.gov

# === OPTION 2: Claude Haiku - Cheapest, fastest ===
# CHAT_BOT_MODEL_NAME=claude-3-5-haiku-20241022
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# === OPTION 3: Ollama (local) ===
# CHAT_BOT_MODEL_NAME=llama3.3:70b
# CHAT_BOT_MODEL_BASE_URL=http://rc-chat.pnl.gov:11434

# MCP Server Configuration
CREATE_TYPICAL_BLDG_MCP_PORT=8082
CREATE_TYPICAL_BLDG_MCP_HOST=localhost

# === Evaluation Configuration ===
# LLM-as-a-judge model for DeepEval metrics
# Default: Ollama (local, no API costs)
OLLAMA_MODEL_NAME=llama3.3:70b
OLLAMA_MODEL_BASE_URL=http://your-ollama-host:11434

# Alternative: OpenAI (uncomment in create_typical_bldg_evaluation.py to enable)
# OPENAI_API_KEY=sk-proj-your-openai-key-here
# OPEN_AI_MODEL_NAME=gpt-4o-mini
