# A2A Agent Server Configuration
CHATBOT_SERVER_URL=http://localhost:8081

# LLM Model Configuration

# === OPTION 1: PNNL BIRTHRIGHT API  ===
# Recommended for access to latest models like o3-mini
BIRTHRIGHT_API=your-birthright-api-key-here
CHAT_BOT_MODEL_NAME=o3-mini-birthright
CHAT_BOT_MODEL_BASE_URL=https://ai-incubator-api.pnnl.gov

# === OPTION 2: Claude Haiku - Cheapest, fastest ===
# CHAT_BOT_MODEL_NAME=claude-3-5-haiku-20241022
# ANTHROPIC_API_KEY=my-anthropic-api-key

# === OPTION 3: Claude Sonnet 4 - Reasoning ===
# CHAT_BOT_MODEL_NAME=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=my-anthropic-api-key

# === OPTION 4: Ollama (local) ===
# CHAT_BOT_MODEL_NAME=llama3.3:70b
# CHAT_BOT_MODEL_BASE_URL=http://rc-chat.pnl.gov:11434

# MCP Server Configuration
CREATE_TYPICAL_BLDG_MCP_PORT=8082
CREATE_TYPICAL_BLDG_MCP_HOST=localhost
